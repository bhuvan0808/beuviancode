# Beuvian environment template.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.
#
# Environment variables sit ABOVE the config file and BELOW CLI flags in the
# resolution order, so anything set here overrides config.yaml. This is the
# recommended way to supply secrets: they stay out of the repository and out of
# container images.
#
# Naming: upper-case the config path and prefix it.
#   backend  BEUVIAN_        server.port         -> BEUVIAN_SERVER_PORT
#   agent    BEUVIAN_AGENT_  coding.adapter      -> BEUVIAN_AGENT_CODING_ADAPTER

# =============================================================================
# Backend
# =============================================================================

BEUVIAN_ENV=development
BEUVIAN_SERVER_PORT=8080
BEUVIAN_LOG_LEVEL=info
BEUVIAN_LOG_FORMAT=json

# --- Supabase PostgreSQL -----------------------------------------------------
# Project Settings -> Database -> Connection string (URI).
# Use the pooler endpoint (port 6543) in production: Supabase caps direct
# connections and multiple backend instances will exhaust the limit.
BEUVIAN_DB_URL=postgres://postgres:postgres@localhost:5432/beuvian?sslmode=disable

# --- Upstash Redis -----------------------------------------------------------
# Console -> your database -> Redis connect URL. Managed Upstash is rediss://.
BEUVIAN_REDIS_URL=redis://localhost:6379

# --- Authentication ----------------------------------------------------------
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App.
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:8080/v1/auth/github/callback
# The callback must match EXACTLY, including scheme and trailing path.
BEUVIAN_AUTH_GITHUB_CLIENT_ID=
BEUVIAN_AUTH_GITHUB_CLIENT_SECRET=
BEUVIAN_AUTH_GITHUB_CALLBACK_URL=http://localhost:8080/v1/auth/github/callback

# Minimum 32 bytes — the HS256 output size. A shorter secret is brute-forceable
# offline against a captured token, and validation rejects it outside development.
# Generate:  openssl rand -base64 48
BEUVIAN_AUTH_JWT_SECRET=

BEUVIAN_AUTH_DASHBOARD_URL=http://localhost:3000

# --- CORS --------------------------------------------------------------------
# Comma-separated. Must be explicit: a wildcard cannot be combined with the
# credentialed refresh cookie, and production rejects plaintext http origins.
BEUVIAN_CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# Desktop Agent
# =============================================================================

BEUVIAN_AGENT_BACKEND_URL=ws://localhost:8080/v1/ws
BEUVIAN_AGENT_BACKEND_API_URL=http://localhost:8080

BEUVIAN_AGENT_CODING_ADAPTER=claude

# The repository the coding agent operates in. Deliberately unset by default: the
# coding agent writes files, so a wrong value destroys real work.
BEUVIAN_AGENT_CODING_WORKING_DIRECTORY=

BEUVIAN_AGENT_LOG_LEVEL=info
BEUVIAN_AGENT_LOG_FORMAT=text

# Issued by the backend at device registration and normally stored in the
# encrypted state file rather than here. Set it only to bypass registration
# during testing.
BEUVIAN_AGENT_DEVICE_TOKEN=

# =============================================================================
# Dashboard (Next.js) — used from phase 4
# =============================================================================

# NEXT_PUBLIC_ variables are inlined into the browser bundle at build time and are
# therefore PUBLIC. Never put a secret behind this prefix.
NEXT_PUBLIC_BEUVIAN_API_URL=http://localhost:8080
NEXT_PUBLIC_BEUVIAN_WS_URL=ws://localhost:8080/v1/ws
